# Basic Auth Configuration
BETTER_AUTH_SECRET=development_secret_key_change_in_production
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=adminpassword

# Environment Configuration
NODE_ENV=development

# URLs
BACKEND_URL=http://localhost:4050
FRONTEND_URL=http://localhost:3050
FRONTEND_RESET_PASSWORD_ROUTE=reset-password

# Database Configuration
DATABASE_URL=postgresql://togena:togena@localhost:5433/togena

# Server Configuration
PORT=4050

# Rate limits of sign-in and the public application (on unless false)
RATE_LIMIT_ENABLED=true

# Staging and demo only: shows the participant a "I paid" button that records a simulated
# payment (US-115). Leave it off (or unset) in production.
PAYMENT_SIMULATION_ENABLED=true

# Staging and demo without a sender domain: an "Ověřit bez e-mailu" button on the verification
# screen verifies a freshly registered organizer without the e-mailed link. Off unless set to true
# (deploy.yml switches it on for the school demo); keep it off wherever real e-mails go out.
EMAIL_VERIFICATION_BYPASS_ENABLED=true

# Mail Configuration
# Resolution order (first match wins): Resend → SMTP → ConsoleMailerAdapter (dev logs).
# Set RESEND_API_KEY to use Resend.
RESEND_API_KEY=
EMAIL_FROM="Togena <onboarding@resend.dev>"
# Or set all three SMTP_* (HOST, USERNAME, PASSWORD) to use SMTP instead.
SMTP_HOST=
SMTP_SECURE=true
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD= 
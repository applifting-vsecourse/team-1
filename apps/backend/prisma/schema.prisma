// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// One account type per user (docs/PROJEKT.md, section 9): an e-mail is either
// an organizer, a participant or the platform admin — never two at once.
enum AccountType {
  ORGANIZER
  PARTICIPANT
  ADMIN

  @@map("account_type")
}

// Gender as on the ID document — rooms are women's or men's (US-14, US-23).
enum Gender {
  FEMALE
  MALE

  @@map("gender")
}

// Language of the UI and e-mails (docs/PROJEKT.md, localization).
enum Locale {
  en
  cs

  @@map("locale")
}

enum ApplicationTermStatus {
  CONFIRMED
  WAITLISTED
  // Terminal (US-28): rejected, cancelled or not obtained a bed. Does not block a new application.
  CANCELLED
  // "K vyhodnocení" (US-102): manual evaluation mode only, waits for the organizer's decision.
  // Takes no bed and owes nothing until confirmed.
  TO_EVALUATE

  @@map("application_term_status")
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("change_request_status")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String      @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?     @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  accountType     AccountType @default(PARTICIPANT)
  // Set for participant accounts created from an application: the first
  // sign-in via magic link forces choosing a password (US-04).
  mustSetPassword Boolean     @default(false)
  // Language of e-mails sent to the account (password reset, verification).
  locale          Locale      @default(en)

  memberships      OrganizationMember[]
  applications     Application[]
  recordedPayments Payment[]
  statusChanges    ApplicationTermStatusChange[]
  submittedChangeRequests ChangeRequest[] @relation("ChangeRequestApplicant")
  reviewedChangeRequests  ChangeRequest[] @relation("ChangeRequestReviewer")
  notifications    Notification[]
  lastOpenedEvent  LastOpenedEvent?

  @@unique([email])
  @@map("user")
}

// --- Togena domain -------------------------------------------------------
// Every table holding an organization's data carries `organizationId`
// directly, so isolation between organizations (US-10) is a single filter.
// Money is whole CZK as Int.

model Organization {
  id          String   @id @default(cuid())
  name        String
  contactEmail String?
  contactPhone String?
  // Czech account number, e.g. "2900123456/2010" — shown with payment details.
  bankAccount String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  members          OrganizationMember[]
  events           Event[]
  terms            Term[]
  rooms            Room[]
  applications     Application[]
  applicationTerms ApplicationTerm[]
  payments         Payment[]
  statusChanges    ApplicationTermStatusChange[]
  substituteSkips  ApplicationTermSkip[]
  changeRequests   ChangeRequest[]
  mealOptions      MealOption[]

  @@map("organization")
}

// Organizer ↔ organization (M:N): one account may act for several organizations.
model OrganizationMember {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

enum EvaluationMode {
  AUTOMATIC
  MANUAL

  @@map("evaluation_mode")
}

enum RoomMode {
  GENDERED
  SHARED

  @@map("room_mode")
}

model Event {
  id                   String         @id @default(cuid())
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String
  name                 String
  // How applications in a term are evaluated (US-101); fixed once applications open.
  evaluationMode       EvaluationMode @default(AUTOMATIC)
  // D-099: payment period from confirmation; D-101: restarted when a correction creates a debt.
  paymentPeriodDays    Int            @default(10)
  // First calendar day when participant changes require organizer approval (US-113/114).
  // Null leaves changes immediate.
  cancellationStartsOn DateTime?      @db.Date
  // Cancellation terms the organizer shows to applicants (US-47), free text; null until written.
  cancellationTerms    String?        @db.Text
  description          String?        @db.Text
  location             String?
  // Public page content (US-122): the one source of the event web and the catalog (US-123).
  contactEmail         String?
  contactPhone         String?
  // Listed in the catalog only when the organizer turns it on explicitly.
  publishedInCatalog   Boolean        @default(false)
  // Unguessable token in the public application link /prihlaska/<publicToken>.
  publicToken          String         @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt

  terms        Term[]
  applications Application[]
  changeRequests ChangeRequest[]
  photo        EventPhoto?
  mealOptions  MealOption[]
  lastOpenedBy LastOpenedEvent[]

  @@index([organizationId])
  @@map("event")
}

// The photo of an event's public page, kept in the database (US-122): the repo has no file
// storage and staging cannot configure one. At most one per event; size and type are validated.
model EventPhoto {
  id          String   @id @default(cuid())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String   @unique
  fileName    String
  contentType String
  data        Bytes
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("event_photo")
}

// A meal restriction the organizer offers on the application of an event (US-64), e.g. vegetarian.
model MealOption {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  name           String
  // Order in which the organizer listed the options.
  position       Int
  createdAt      DateTime     @default(now())

  applications Application[]

  @@index([organizationId])
  @@index([eventId, position])
  @@map("meal_option")
}

model Term {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  // Ordinal of the term within the event, 1–999 (US-137). Part of the variable symbol:
  // assigned once as highest + 1, never changed, renumbered or reused — a cancelled term keeps it.
  number         Int
  // Optional (D-053): a term is defined by its dates; an unnamed term shows just the dates.
  name           String?
  startsOn       DateTime     @db.Date
  endsOn         DateTime     @db.Date
  priceCzk       Int
  // Rooms are divided by gender or shared; each term has its own mode (US-99, D-062).
  roomMode       RoomMode     @default(GENDERED)
  // Cancelled terms stay for the history of applications but are no longer offered (US-13).
  cancelledAt    DateTime?
  cancelReason   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  applicationTerms ApplicationTerm[]
  rooms            Room[]

  @@unique([eventId, number])
  @@index([organizationId])
  @@index([eventId])
  @@map("term")
}

// A room belongs to exactly one term (US-99, D-052).
model Room {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId         String
  name           String
  // At least one bed; no product upper limit (US-14).
  capacity       Int
  gender         Gender?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([organizationId])
  @@index([termId])
  @@map("room")
}

model Application {
  id             String       @id @default(cuid())
  // Sequential application number, used as the variable symbol (VS) for payment.
  number         Int          @unique @default(autoincrement())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  // Participant account the application is attached to (US-01). Nullable so
  // the application can be stored before the account exists.
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  // Secret for the confirmation page /prihlaska/potvrzeni/<accessToken> (US-25).
  accessToken    String       @unique
  firstName      String
  lastName       String
  birthDate      DateTime     @db.Date
  gender         Gender
  email          String
  consentAt      DateTime
  // UI language at submission — the confirmation e-mail goes out in it.
  locale         Locale       @default(en)
  // Arrival time on the server — decides the order of evaluation (US-27).
  submittedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  // Meal restrictions of the participant (US-64): ticked options of the event and free text.
  mealOptions   MealOption[]
  allergies     String?      @db.Text
  specialRequest String?     @db.Text

  terms         ApplicationTerm[]
  notifications Notification[]
  changeRequests ChangeRequest[]

  @@index([organizationId])
  @@index([eventId, submittedAt])
  @@index([userId])
  @@map("application")
}

// A requested selection is a snapshot until an organizer decides. ApplicationTerm rows stay
// untouched while pending. The event lock serializes submissions and decisions for one event.
model ChangeRequest {
  id               String              @id @default(cuid())
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId   String
  event            Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId          String
  application      Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId    String
  applicant        User                @relation("ChangeRequestApplicant", fields: [applicantId], references: [id])
  applicantId      String
  currentTermIds   String[]
  requestedTermIds String[]
  status           ChangeRequestStatus @default(PENDING)
  rejectionReason  String?             @db.Text
  reviewedBy       User?               @relation("ChangeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById     String?
  createdAt        DateTime            @default(now())
  reviewedAt       DateTime?
  notificationReadAt DateTime?

  @@index([organizationId, eventId, status, createdAt])
  @@index([applicantId, applicationId, createdAt])
  @@map("change_request")
}

// Result of evaluating one selected term of an application (US-27).
model ApplicationTerm {
  id                     String                @id @default(cuid())
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         String
  application            Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId          String
  term                   Term                  @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId                 String
  status                 ApplicationTermStatus
  // Term price frozen at evaluation; later price changes affect only new applications.
  priceCzk               Int
  evaluatedAt            DateTime              @default(now())
  // Restart of the payment period after a correction/removal; null = original confirmation period.
  paymentPeriodStartedAt DateTime?
  // Successful delivery of the one payment reminder for this term (D-102); written by US-46.
  paymentReminderSentAt  DateTime?

  statusChanges ApplicationTermStatusChange[]
  payments      Payment[]
  skippedIn     ApplicationTermSkip[]

  @@unique([applicationId, termId])
  @@index([termId, status])
  @@index([organizationId])
  @@map("application_term")
}

// System log of every status change of an application in a term (US-28): who, when, from which
// status to which. Written by the one status service, so later stories (waitlist, cancellation,
// manual add) reuse it. `changedBy` is null when the system itself changed the status.
model ApplicationTermStatusChange {
  id                String                @id @default(cuid())
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  applicationTerm   ApplicationTerm       @relation(fields: [applicationTermId], references: [id], onDelete: Cascade)
  applicationTermId String
  fromStatus        ApplicationTermStatus
  toStatus          ApplicationTermStatus
  changedBy         User?                 @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById       String?
  createdAt         DateTime              @default(now())

  skips ApplicationTermSkip[]

  @@index([applicationTermId, createdAt])
  @@index([organizationId])
  @@map("application_term_status_change")
}

// Waitlisted applications skipped when someone else was confirmed from the waitlist (US-105):
// those ahead of the confirmed one in the same queue (term and bed group) who stayed on the
// waitlist. Written in the transaction of the status change, never edited or deleted by the app.
// A confirmation from the waitlist without rows here skipped nobody.
model ApplicationTermSkip {
  id                       String                      @id @default(cuid())
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId           String
  statusChange             ApplicationTermStatusChange @relation(fields: [statusChangeId], references: [id], onDelete: Cascade)
  statusChangeId           String
  skippedApplicationTerm   ApplicationTerm             @relation(fields: [skippedApplicationTermId], references: [id], onDelete: Cascade)
  skippedApplicationTermId String
  createdAt                DateTime                    @default(now())

  @@unique([statusChangeId, skippedApplicationTermId])
  @@index([skippedApplicationTermId])
  @@index([organizationId])
  @@map("application_term_skip")
}

// Where a payment row comes from. SIMULATION is the staging/demo button of the participant (US-115).
enum PaymentSource {
  MANUAL
  SIMULATION
}

// Manually recorded payment (US-44) of one application in a term (US-137, D-051). Rows rather
// than a flag so a bank statement import (US-42) can add more later. One receipt (money that
// arrived at once) is one or more rows sharing `receiptId`; a refund is a negative row.
model Payment {
  id                String          @id @default(cuid())
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String
  applicationTerm   ApplicationTerm @relation(fields: [applicationTermId], references: [id], onDelete: Cascade)
  applicationTermId String
  receiptId         String
  // Set on a replacement receipt; all its rows point to the original receipt.
  correctsReceiptId String?
  // New receipts remember whether the organizer used the summary symbol; null is legacy data.
  isSummary         Boolean?
  amountCzk         Int
  source            PaymentSource   @default(MANUAL)
  recordedBy        User            @relation(fields: [recordedById], references: [id])
  recordedById      String
  createdAt         DateTime        @default(now())
  cancelledAt       DateTime?

  @@index([organizationId])
  @@index([applicationTermId])
  @@index([receiptId])
  @@index([correctsReceiptId])
  @@map("payment")
}

// In-app notification of a user (US-118); the organizer's bell (US-86) builds on it. The copy is
// not stored: the frontend composes it from `type`, `kind` and `params` in the reader's language.
// Written in the transaction of the change it describes. `readAt` null = unread.
model Notification {
  id            String           @id @default(cuid())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  type          NotificationType
  // The event within the type, e.g. CONFIRMED, PAYMENT_RECORDED.
  kind          String
  // The application the notification leads to; null for notifications that belong to none.
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String?
  // Data the copy is composed from (event, participant, term dates, amounts).
  params        Json
  createdAt     DateTime         @default(now())
  readAt        DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([applicationId])
  @@map("notification")
}

enum NotificationType {
  STATUS_CHANGED
  PAYMENT
  REQUEST
}

// The event an organizer opened last (US-51): where the administration lands after login,
// on any device. One row per user; gone with the user or the event.
model LastOpenedEvent {
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String   @id
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId  String
  openedAt DateTime @default(now())

  @@index([eventId])
  @@map("last_opened_event")
}

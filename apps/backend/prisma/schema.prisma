// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// One account type per user (docs/PROJEKT.md, section 10): an e-mail is either
// an organizer, a participant or the platform admin — never two at once.
enum AccountType {
  ORGANIZER
  PARTICIPANT
  ADMIN

  @@map("account_type")
}

// Gender as on the ID document — rooms are women's or men's (US-14, US-23).
enum Gender {
  FEMALE
  MALE

  @@map("gender")
}

// Language of the UI and e-mails (docs/PROJEKT.md, localization).
enum Locale {
  en
  cs

  @@map("locale")
}

enum ApplicationTermStatus {
  CONFIRMED
  WAITLISTED

  @@map("application_term_status")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id              String      @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?     @db.Text
  createdAt       DateTime
  updatedAt       DateTime
  sessions        Session[]
  accounts        Account[]
  accountType     AccountType @default(PARTICIPANT)
  // Set for participant accounts created from an application: the first
  // sign-in via magic link forces choosing a password (US-04).
  mustSetPassword Boolean     @default(false)
  // Language of e-mails sent to the account (password reset, verification).
  locale          Locale      @default(en)

  memberships      OrganizationMember[]
  applications     Application[]
  recordedPayments Payment[]

  @@unique([email])
  @@map("user")
}

// --- Togena domain -------------------------------------------------------
// Every table holding an organization's data carries `organizationId`
// directly, so isolation between organizations (US-10) is a single filter.
// Money is whole CZK as Int.

model Organization {
  id          String   @id @default(cuid())
  name        String
  // Czech account number, e.g. "2900123456/2010" — shown with payment details.
  bankAccount String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  members          OrganizationMember[]
  events           Event[]
  terms            Term[]
  rooms            Room[]
  applications     Application[]
  applicationTerms ApplicationTerm[]
  payments         Payment[]

  @@map("organization")
}

// Organizer ↔ organization (M:N): one account may act for several organizations.
model OrganizationMember {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

enum RoomMode {
  GENDERED
  SHARED

  @@map("room_mode")
}

model Event {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  description    String?      @db.Text
  location       String?
  roomMode       RoomMode     @default(GENDERED)
  // Unguessable token in the public application link /prihlaska/<publicToken>.
  publicToken    String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  terms        Term[]
  rooms        Room[]
  applications Application[]

  @@index([organizationId])
  @@map("event")
}

model Term {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  name           String
  startsOn       DateTime     @db.Date
  endsOn         DateTime     @db.Date
  priceCzk       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  applicationTerms ApplicationTerm[]

  @@index([organizationId])
  @@index([eventId])
  @@map("term")
}

// Rooms belong to the event and apply to all of its terms (US-14).
model Room {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  name           String
  // At least 1 bed, validated in the DTO.
  capacity       Int
  gender         Gender?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@map("room")
}

model Application {
  id             String       @id @default(cuid())
  // Sequential application number, used as the variable symbol (VS) for payment.
  number         Int          @unique @default(autoincrement())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  // Participant account the application is attached to (US-01). Nullable so
  // the application can be stored before the account exists.
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  // Secret for the confirmation page /prihlaska/potvrzeni/<accessToken> (US-25).
  accessToken    String       @unique
  firstName      String
  lastName       String
  birthDate      DateTime     @db.Date
  gender         Gender
  email          String
  consentAt      DateTime
  // UI language at submission — the confirmation e-mail goes out in it.
  locale         Locale       @default(en)
  // Arrival time on the server — decides the order of evaluation (US-27).
  submittedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  terms    ApplicationTerm[]
  payments Payment[]

  @@index([organizationId])
  @@index([eventId, submittedAt])
  @@index([userId])
  @@map("application")
}

// Result of evaluating one selected term of an application (US-27).
model ApplicationTerm {
  id             String                @id @default(cuid())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  application    Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String
  term           Term                  @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId         String
  status         ApplicationTermStatus
  // Term price frozen at evaluation; later price changes affect only new applications.
  priceCzk       Int
  evaluatedAt    DateTime              @default(now())

  @@unique([applicationId, termId])
  @@index([termId, status])
  @@index([organizationId])
  @@map("application_term")
}

// Manually recorded payment (US-44). Rows rather than a flag so a bank
// statement import (US-42) can add more later.
model Payment {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String
  amountCzk      Int
  recordedBy     User         @relation(fields: [recordedById], references: [id])
  recordedById   String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([applicationId])
  @@map("payment")
}
